# Copy to .env and fill in your key. Never commit .env.

# OpenRouter API key -- get one at https://openrouter.ai/keys
LLM_KEY=sk-or-v1-your-key-here
LLM_URL=https://openrouter.ai/api/v1

# The two independent graders. Keep these different models -- agreement
# between two runs of the same model tells you nothing.
# Both must accept image input, since the vision grader sends PDF pages.
MODEL_1=openai/gpt-4.1-nano
MODEL_2=google/gemini-2.5-flash

# Graders for the vision route (handwritten submissions). Default to the pair
# above; raise them if handwriting grading looks unreliable.
VISION_GRADER_1=openai/gpt-4.1-nano
VISION_GRADER_2=google/gemini-2.5-flash

# Cheaper supporting work: locating question boundaries, describing figures.
SPLITTER_MODEL=google/gemini-2.5-flash
VISION_MODEL=google/gemini-2.5-flash

GRADE_CONFLICT_LIMIT=10
GRADE_RESOLUTION=max
MAX_WORKERS=5

# --- Per-course customisation (both optional) --------------------------------
# Grade one question part by part. Empty = grade the question as a whole.
# QUESTION_PARTS=a,b,c

# Record a descriptive label next to each grade: a name from tagsets/ or a path
# to a JSON scheme. Tags never affect grades. Empty = no tagging at all.
# TAG_SCHEME=sql_constructs
